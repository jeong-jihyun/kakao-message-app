# 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=여기에_REST_API_키
# 같은 화면 '클라이언트 시크릿' > 카카오 로그인 줄의 코드 (활성화 ON이면 필수)
KAKAO_CLIENT_SECRET=
# 로그인 후 돌아올 주소 (카카오 콘솔 '카카오 로그인 리다이렉트 URI'와 똑같아야 함)
#  내 컴퓨터: http://localhost:3000/api/auth/callback
#  배포 후  : https://배포주소.vercel.app/api/auth/callback
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/callback
# 관리 키: 최초 인증과 /api/notify 호출에 쓰는 나만 아는 긴 문자열 (직접 정하세요)
NOTIFY_SECRET=여기에_길고_아무도_모르는_문자열

# --- 아래는 자동/테스트용 ---
# Vercel Blob 저장소를 프로젝트에 연결하면 BLOB_READ_WRITE_TOKEN 이 자동으로 들어옵니다.
# 내 컴퓨터에서 테스트할 때만, 토큰을 파일로 저장할 폴더를 적습니다.
# TOKEN_STORE_DIR=./.tokens
